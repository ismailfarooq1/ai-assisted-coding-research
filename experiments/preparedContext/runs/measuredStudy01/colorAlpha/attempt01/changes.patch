@@ -0,0 +1,27 @@
+import { describe, expect, test } from "vitest";
+import { colorToHex } from "@/lib/color";
+
+describe("colorToHex", () => {
+  test("keeps six-digit RGB output when alpha is omitted or undefined", () => {
+    expect(colorToHex({ red: 1, green: 0.5, blue: 0 })).toBe("#ff8000");
+    expect(colorToHex({ red: 1, green: 0.5, blue: 0 }, undefined)).toBe("#ff8000");
+  });
+
+  test.each([
+    [1, "#ff8000ff"],
+    [0, "#ff800000"],
+    [0.5, "#ff800080"],
+    [-1, "#ff800000"],
+    [2, "#ff8000ff"],
+    [Number.NaN, "#ff8000ff"],
+    [Number.POSITIVE_INFINITY, "#ff8000ff"],
+    [Number.NEGATIVE_INFINITY, "#ff8000ff"],
+  ])("converts alpha %s", (alpha, expected) => {
+    expect(colorToHex({ red: 1, green: 0.5, blue: 0 }, alpha)).toBe(expected);
+  });
+
+  test("preserves RGB clamping, rounding, and missing-color behavior", () => {
+    expect(colorToHex({ red: 2, green: 0.5, blue: Number.NaN })).toBe("#ff8000");
+    expect(colorToHex(undefined, 0.5)).toBeUndefined();
+  });
+});

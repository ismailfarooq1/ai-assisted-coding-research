+++ b/web/tests/color.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it } from "vitest";
+import { colorToHex } from "@/lib/color";
+
+describe("colorToHex", () => {
+  it("keeps RGB output when alpha is omitted or undefined", () => {
+    expect(colorToHex({ red: 1, green: 0.5, blue: 0 })).toBe("#ff8000");
+    expect(colorToHex({ red: 1 }, undefined)).toBe("#ff0000");
+  });
+
+  it("appends rounded, clamped lowercase alpha bytes when alpha is provided", () => {
+    expect(colorToHex({ red: 1, green: 0.5, blue: 0 }, 1)).toBe("#ff8000ff");
+    expect(colorToHex({ red: 0, green: 0, blue: 0 }, 0.5)).toBe("#00000080");
+    expect(colorToHex({ red: 0, green: 0, blue: 0 }, -1)).toBe("#00000000");
+    expect(colorToHex({ red: 0, green: 0, blue: 0 }, 2)).toBe("#000000ff");
+    expect(colorToHex({ red: 0, green: 0, blue: 0 }, Number.NaN)).toBe("#000000ff");
+  });
+
+  it("preserves missing-color behavior", () => {
+    expect(colorToHex(undefined, 0.5)).toBeUndefined();
+  });
+});

diff --git a/web/src/lib/release-version.ts b/web/src/lib/release-version.ts
index 22fbda9..a0402e8 100644
--- a/web/src/lib/release-version.ts
+++ b/web/src/lib/release-version.ts
@@ -1,8 +1,10 @@
 // Release links accept calendar releases YY.MM.N[-rc.K] and historical 0.x releases.
-const isReleaseVersion = (version: string): boolean =>
-  /^(?:[1-9]\d\.(?:0[1-9]|1[0-2])\.(?:0|[1-9]\d*)|0\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*))(?:-rc\.[1-9]\d*)?$/.test(version);
+const releaseVersionPattern = /^(?:[1-9]\d\.(?:0[1-9]|1[0-2])\.(?:0|[1-9]\d*)|0\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*))(?:-rc\.[1-9]\d*)?$/;
+const isReleaseVersion = (version: string): boolean => releaseVersionPattern.test(version);
+const isPrefixedLegacyReleaseTag = (version: string): boolean => /^v0\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)(?:-rc\.[1-9]\d*)?$/.test(version);
 
 export const getReleaseTag = (version: string): string | undefined => {
+  if (isPrefixedLegacyReleaseTag(version)) return version;
   if (!isReleaseVersion(version)) return undefined;
   return version.startsWith("0.") ? `v${version}` : version;
 };

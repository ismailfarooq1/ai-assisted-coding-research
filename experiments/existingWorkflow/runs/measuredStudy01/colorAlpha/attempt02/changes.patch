+++ b/web/tests/color.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vitest";
+import { colorToHex } from "@/lib/color";
+
+describe("colorToHex", () => {
+  const color = { red: 1, green: 0.5, blue: 0 };
+
+  it("keeps six digit RGB output when alpha is omitted or undefined", () => {
+    expect(colorToHex(color)).toBe("#ff8000");
+    expect(colorToHex(color, undefined)).toBe("#ff8000");
+    expect(colorToHex()).toBeUndefined();
+  });
+
+  it("appends rounded, lowercase alpha hex when explicitly provided", () => {
+    expect(colorToHex(color, 1)).toBe("#ff8000ff");
+    expect(colorToHex(color, 0.5)).toBe("#ff800080");
+    expect(colorToHex(color, 0)).toBe("#ff800000");
+  });
+
+  it("clamps finite alpha and defaults non-finite alpha to opaque", () => {
+    expect(colorToHex(color, -1)).toBe("#ff800000");
+    expect(colorToHex(color, 2)).toBe("#ff8000ff");
+    expect(colorToHex(color, Number.NaN)).toBe("#ff8000ff");
+    expect(colorToHex(color, Number.POSITIVE_INFINITY)).toBe("#ff8000ff");
+  });
+
+  it("preserves RGB clamping, rounding, and missing channel behavior", () => {
+    expect(colorToHex({ red: 2, green: -1, blue: 0.5 }, 0.25)).toBe("#ff008040");
+    expect(colorToHex({}, 0.25)).toBe("#00000040");
+    expect(colorToHex(undefined, 0.25)).toBeUndefined();
+  });
+});
